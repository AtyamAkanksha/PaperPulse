# ==========================================
# PaperPulse Environment Configuration
# ==========================================

# Security & JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Configure at least one for AI summaries & quiz generation)
# 1. Groq (Fast & Recommended)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./paperpulse.db

# OCR Configuration (Optional: Path to Tesseract OCR executable on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
